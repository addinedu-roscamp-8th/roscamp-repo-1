/* 밝은 컬러 테마 스타일시트 */

/* 전체 배경 */
QWidget {
    background-color: #FAFAF7;
    color: #2E2E2E;
    font-family: "맑은 고딕", "Malgun Gothic", sans-serif;
}

/* 메인 윈도우 */
QMainWindow {
    background-color: #FAFAF7;
}

/* 버튼 스타일 */
QPushButton {
    background-color: #4F7F6A;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6FA18C;
}

QPushButton:pressed {
    background-color: #3E6654;
}

QPushButton:disabled {
    background-color: #D4D4D4;
    color: #6B6B6B;
}

/* 주요 버튼 (주문하기, 확인 등) */
QPushButton#btn_start_order,
QPushButton#btn_confirm_order,
QPushButton#btn_submit,
QPushButton#btn_confirm_delivery {
    background-color: #3E6654;
    font-size: 28px;
}

QPushButton#btn_start_order:hover,
QPushButton#btn_confirm_order:hover,
QPushButton#btn_submit:hover,
QPushButton#btn_confirm_delivery:hover {
    background-color: #355A4B;
}

QPushButton#btn_start_order:pressed,
QPushButton#btn_confirm_order:pressed,
QPushButton#btn_submit:pressed,
QPushButton#btn_confirm_delivery:pressed {
    background-color: #2C4A3D;
}

/* 취소/뒤로가기 버튼 */
QPushButton#btn_cancel,
QPushButton#btn_back {
    background-color: #DDE3DC;
    color: #2E2E2E;
}

QPushButton#btn_cancel:hover,
QPushButton#btn_back:hover {
    background-color: #C9D6CF;
}

QPushButton#btn_cancel:pressed,
QPushButton#btn_back:pressed {
    background-color: #B6C8BF;
}

/* 레이블 */
QLabel {
    background-color: transparent;
    color: #2E2E2E;
}

/* 제목 레이블 */
QLabel#label_welcome,
QLabel#label_title {
    color: #2F5D50;
}

QLabel#label_menu_title,
QLabel#label_cart_title {
    color: #6FA18C;
    background-color: #C9D6CF;
    padding: 10px;
    border-radius: 5px;
}

/* 합계 레이블 */
QLabel#label_total {
    color: #3E6654;
    background-color: #C9D6CF;
    padding: 10px;
    border-radius: 5px;
}

/* 리스트 위젯 */
QListWidget {
    background-color: #FFFFFF;
    border: 2px solid #C9D6CF;
    border-radius: 10px;
    padding: 5px;
}

QListWidget::item {
    background-color: #FAFAF7;
    border: 1px solid #C9D6CF;
    border-radius: 5px;
    padding: 10px;
    margin: 3px;
}

QListWidget::item:hover {
    background-color: #EFEDE6;
    border-color: #4F7F6A;
}

QListWidget::item:selected {
    background-color: #C9D6CF;
    border-color: #3E6654;
    color: #2E2E2E;
}

/* 품절 메뉴 (회색) */
QListWidget::item[unavailable="true"] {
    background-color: #F3F3EE;
    color: #7A7A7A;
}

/* 스크롤 영역 */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* 스크롤바 */
QScrollBar:vertical {
    background-color: #C9D6CF;
    width: 15px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #4F7F6A;
    border-radius: 7px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6FA18C;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #C9D6CF;
    height: 15px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background-color: #4F7F6A;
    border-radius: 7px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6FA18C;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 텍스트 편집기 */
QTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #C9D6CF;
    border-radius: 10px;
    padding: 10px;
}

QTextEdit[readOnly="true"] {
    background-color: #FAFAF7;
}

/* 구분선 */
Line {
    background-color: #4F7F6A;
}

/* 다이얼로그 */
QDialog {
    background-color: #FAFAF7;
}

/* 스핀박스 */
QSpinBox {
    background-color: #FFFFFF;
    border: 2px solid #C9D6CF;
    border-radius: 5px;
    padding: 5px;
    font-size: 18px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #4F7F6A;
    border-radius: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #6FA18C;
}

/* 메시지박스 */
QMessageBox {
    background-color: #FAFAF7;
}

QMessageBox QPushButton {
    min-width: 100px;
    min-height: 40px;
}

/* 음성 피드백 위젯 특수 스타일 */
VoiceFeedbackWidget {
    background-color: #D8E6DF;
    border-radius: 15px;
}

/* 영수증 위젯 */
QWidget#widget_receipt {
    background-color: #FFFFFF;
    border: 3px solid #4F7F6A;
    border-radius: 15px;
    padding: 20px;
}

/* 도착 알림 위젯 */
QWidget#DeliveryNotification {
    background-color: #EAF2ED;
}
