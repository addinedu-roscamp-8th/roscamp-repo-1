/* 밝은 컬러 테마 스타일시트 */

/* 전체 배경 */
QWidget {
    background-color: #FFF8E1;
    color: #333333;
    font-family: "맑은 고딕", "Malgun Gothic", sans-serif;
}

/* 메인 윈도우 */
QMainWindow {
    background-color: #FFF8E1;
}

/* 버튼 스타일 */
QPushButton {
    background-color: #FFB74D;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FFA726;
}

QPushButton:pressed {
    background-color: #FF9800;
}

QPushButton:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

/* 주요 버튼 (주문하기, 확인 등) */
QPushButton#btn_start_order,
QPushButton#btn_confirm_order,
QPushButton#btn_submit,
QPushButton#btn_confirm_delivery {
    background-color: #FF7043;
    font-size: 28px;
}

QPushButton#btn_start_order:hover,
QPushButton#btn_confirm_order:hover,
QPushButton#btn_submit:hover,
QPushButton#btn_confirm_delivery:hover {
    background-color: #FF5722;
}

QPushButton#btn_start_order:pressed,
QPushButton#btn_confirm_order:pressed,
QPushButton#btn_submit:pressed,
QPushButton#btn_confirm_delivery:pressed {
    background-color: #F4511E;
}

/* 취소/뒤로가기 버튼 */
QPushButton#btn_cancel,
QPushButton#btn_back {
    background-color: #90CAF9;
    color: #FFFFFF;
}

QPushButton#btn_cancel:hover,
QPushButton#btn_back:hover {
    background-color: #64B5F6;
}

QPushButton#btn_cancel:pressed,
QPushButton#btn_back:pressed {
    background-color: #42A5F5;
}

/* 레이블 */
QLabel {
    background-color: transparent;
    color: #333333;
}

/* 제목 레이블 */
QLabel#label_welcome,
QLabel#label_title {
    color: #FF6F00;
}

QLabel#label_menu_title,
QLabel#label_cart_title {
    color: #FF8A65;
    background-color: #FFE0B2;
    padding: 10px;
    border-radius: 5px;
}

/* 합계 레이블 */
QLabel#label_total {
    color: #E65100;
    background-color: #FFE0B2;
    padding: 10px;
    border-radius: 5px;
}

/* 리스트 위젯 */
QListWidget {
    background-color: #FFFFFF;
    border: 2px solid #FFE0B2;
    border-radius: 10px;
    padding: 5px;
}

QListWidget::item {
    background-color: #FFFBF0;
    border: 1px solid #FFE0B2;
    border-radius: 5px;
    padding: 10px;
    margin: 3px;
}

QListWidget::item:hover {
    background-color: #FFF3E0;
    border-color: #FFB74D;
}

QListWidget::item:selected {
    background-color: #FFE0B2;
    border-color: #FF9800;
    color: #333333;
}

/* 품절 메뉴 (회색) */
QListWidget::item[unavailable="true"] {
    background-color: #F5F5F5;
    color: #999999;
}

/* 스크롤 영역 */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* 스크롤바 */
QScrollBar:vertical {
    background-color: #FFE0B2;
    width: 15px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #FFB74D;
    border-radius: 7px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFA726;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #FFE0B2;
    height: 15px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background-color: #FFB74D;
    border-radius: 7px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFA726;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 텍스트 편집기 */
QTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #FFE0B2;
    border-radius: 10px;
    padding: 10px;
}

QTextEdit[readOnly="true"] {
    background-color: #FFFBF0;
}

/* 구분선 */
Line {
    background-color: #FFB74D;
}

/* 다이얼로그 */
QDialog {
    background-color: #FFF8E1;
}

/* 스핀박스 */
QSpinBox {
    background-color: #FFFFFF;
    border: 2px solid #FFE0B2;
    border-radius: 5px;
    padding: 5px;
    font-size: 18px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #FFB74D;
    border-radius: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #FFA726;
}

/* 메시지박스 */
QMessageBox {
    background-color: #FFF8E1;
}

QMessageBox QPushButton {
    min-width: 100px;
    min-height: 40px;
}

/* 음성 피드백 위젯 특수 스타일 */
VoiceFeedbackWidget {
    background-color: #E3F2FD;
    border-radius: 15px;
}

/* 영수증 위젯 */
QWidget#widget_receipt {
    background-color: #FFFFFF;
    border: 3px solid #FFB74D;
    border-radius: 15px;
    padding: 20px;
}

/* 도착 알림 위젯 */
QWidget#DeliveryNotification {
    background-color: #FFF9C4;
}
