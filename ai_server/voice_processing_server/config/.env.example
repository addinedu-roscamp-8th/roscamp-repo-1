# OpenAI API Key (required for STT, TTS, Wake word intent)
OPENAI_API_KEY=sk-your-key-here

# Optional: override config path
# CONFIG_DIR=./config

# Order Backend (Main Server TCP). 통합 테스트 시 Mock 서버로 설정.
# ORDER_BACKEND_HOST=127.0.0.1
# ORDER_BACKEND_PORT=9999
# Mock 사용 시: python3 tests/integration/mock_backend_server.py --port 9998 후
# ORDER_BACKEND_PORT=9998

# Voice order default table (1~4)
# VOICE_ORDER_TABLE_NUMBER=1
